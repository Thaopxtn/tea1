# Required for production SEO. Replace with your real HTTPS domain before launch.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Required for orders/admin writes. Use a production PostgreSQL URL with TLS.
DATABASE_URL=postgresql://user:password@host:5432/tra_moc_suong?sslmode=require

# Required for production admin login. Replace all placeholders with real secrets.
ADMIN_AUTH_REQUIRED=true
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-private-password

# Keep disabled until VNPay/MoMo are fully configured and tested.
PAYMENT_MODE=disabled

# Optional public business identity. Uncomment only when you have verified details.
# NEXT_PUBLIC_LEGAL_NAME=Tra Moc Suong
# NEXT_PUBLIC_HOTLINE=0900000000
# NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
# NEXT_PUBLIC_BUSINESS_ADDRESS=Your verified business address
# NEXT_PUBLIC_TAX_CODE=Your verified tax code
# NEXT_PUBLIC_BUSINESS_LICENSE=Your verified business license

# Optional VNPay merchant settings. Do not add these to Vercel while PAYMENT_MODE=disabled.
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Optional MoMo merchant settings. Do not add these to Vercel while PAYMENT_MODE=disabled.
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# MOMO_PAYMENT_URL=https://test-payment.momo.vn/v2/gateway/api/create
# MOMO_IPN_URL=https://your-domain.example/api/payments/momo/ipn

# Optional email/contact/newsletter webhook. Omit both variables until you have a real webhook.
# EMAIL_WEBHOOK_URL=
# EMAIL_WEBHOOK_TOKEN=
