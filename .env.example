# Public website identity (required for production SEO)
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_ANALYTICS_DEBUG=false
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_HOTLINE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_TAX_CODE=
NEXT_PUBLIC_BUSINESS_LICENSE=

# PostgreSQL / Prisma (required to accept orders or admin writes)
DATABASE_URL=postgresql://user:password@host:5432/tra_moc_suong?sslmode=require

# Admin authentication (all required in production)
ADMIN_AUTH_REQUIRED=true
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Payments: disabled | live
PAYMENT_MODE=disabled

# VNPay merchant settings
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# MoMo merchant settings
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_PAYMENT_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_IPN_URL=https://your-domain.example/api/payments/momo/ipn

# Transactional email/contact/newsletter webhook
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=